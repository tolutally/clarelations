{
  "name": "clarelations",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=frontend",
    "backend:dev": "npm run dev --workspace=backend",
    "frontend:dev": "npm run dev --workspace=frontend",
    "backend:start": "npm run start --workspace=backend",
    "frontend:build": "npm run build --workspace=frontend",
    "install:all": "npm install && npm install --workspace=backend && npm install --workspace=frontend",
    "railway:backend": "npm run start --workspace=backend",
    "railway:frontend": "npm run railway:frontend --workspace=frontend",
    "build:railway": "npm run build:railway --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
